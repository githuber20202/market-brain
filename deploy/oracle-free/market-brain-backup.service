[Unit]
Description=Market Brain PostgreSQL backup
Requires=docker.service
After=docker.service market-brain.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/market-brain
ExecStart=/opt/market-brain/scripts/backup_postgres.sh
UMask=0077
StandardOutput=append:/var/log/market-brain/backup.log
StandardError=append:/var/log/market-brain/backup.log

